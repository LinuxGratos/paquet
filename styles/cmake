# Style cmake: build=cmake (also build=kde5)
# Sourced as the build() function of the recipe, from $SRC, with set -e.

cmake -B build \
      -S "$name-$version" \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DBUILD_TESTING=OFF \
      -Wno-dev

cmake --build build
DESTDIR="$PKG" cmake --install build
