# Style kde6: build=kde6 (also build=plasma), Qt 6
# Sourced as the build() function of the recipe, from $SRC, with set -e.

cmake -B build \
      -S "$name-$version" \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DQT_MAJOR_VERSION=6 \
      -DBUILD_TESTING=OFF \
      -Wno-dev

cmake --build build
DESTDIR="$PKG" cmake --install build
